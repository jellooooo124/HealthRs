# Copy to .env and fill in:  cp .env.example .env

# DashScope (Alibaba Cloud Model Studio). One key serves all LLMs used here:
# qwen3.8-max / qwen3.8-max-0902 (agents), deepseek-v4.1-flash (simulated user),
# kimi-k3 (judge), qwen3.7-text-embedding-flash (RAG embeddings).
DASHSCOPE_API_KEY=sk-your-dashscope-key
# OpenAI-compatible endpoint (use https://dashscope-intl.aliyuncs.com/compatible-mode/v1 for an international account)
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
