# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# .env is committed on purpose: it holds a temporary, limited key for the teaching team (private repo).

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Raw data (download from Kaggle, see README) and everything the pipeline regenerates
data/raw/*
!data/raw/.gitkeep
data/processed/
data/processed_sample/
data/chroma_db/
data/guidelines/uploads/
memory_sessions/

# Results: only the final tables/figures/run summaries, the two serving checkpoints and the
# agent-evaluation logs are committed; everything else is regenerated by scripts/reproduce.sh
outputs/checkpoints/*
!outputs/checkpoints/f_bpr_s2026.pt
!outputs/checkpoints/f_hA_s2026.pt
outputs/logs/
outputs/agent_eval/llm_cache.sqlite
outputs/agent_eval/*/memory/
outputs_sample/
outputs_reproduced/
*.log

# Credentials must never enter the public repository
.env
.env.*
!.env.example
*.pem
*.key
